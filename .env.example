PORT=4000

# ===== DATABASE (required) =====
# MongoDB connection string. All users, payments and payouts are stored here,
# so nothing is lost on restart / redeploy / changing Railway account.
# Best: free MongoDB Atlas (works with any Railway account), e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# On Railway's MongoDB plugin you can instead set MONGODB_URI=${{MongoDB.MONGO_URL}}
MONGODB_URI=
MONGODB_DB=betabothub

# ===== HISTORY CLEANUP =====
# Orders/payouts older than this many days are emailed (CSV) to each user and to you,
# then removed. User accounts and total balance are NEVER deleted.
HISTORY_RETENTION_DAYS=30
CLEANUP_EVERY_DAYS=30
NODE_ENV=production
BRAND_NAME=BETA BOT HUB
OWNER_NAME=THE SHIV
# Public website address (used in pay links), e.g. https://pay.yourdomain.com
PUBLIC_URL=

# Owner FamPay UPI ID – all customer payments come here
FAMPAY_UPI_ID=yourname@fam
UPI_PAYEE_NAME=BETA BOT HUB

# Owner Gmail that receives FamPay payment alerts AND sends emails to users
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

PLATFORM_COMMISSION_PERCENT=4
ORDER_EXPIRY_MINUTES=30
IMAP_POLL_SECONDS=20

# Owner panel at /admin
ADMIN_PASSWORD=change-this

# Telegram (optional – payment alerts to your channel/group via your bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@betabot_hub
TELEGRAM_GROUP=@betabot_support
TELEGRAM_CHANNEL=@betabot_hub
OWNER_TELEGRAM=@sukoon_s
